{
  "name": "media-player",
  "version": "1.0.0",
  "description": "음원/영상 재생목록 플레이어",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.61.1"
  },
  "build": {
    "appId": "com.mediaplayer.app",
    "productName": "Media Player",
    "publish": {
      "provider": "github",
      "owner": "museloper",
      "repo": "media-player"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "artifactName": "MediaPlayer-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MediaPlayerSetup.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
